# Use `memory` for the free, dependency-free demo and E2E backend.
# Use `supabase` after starting local Supabase or connecting a free cloud project.
DATA_BACKEND=memory

# Server-only values. Never prefix the secret key with NEXT_PUBLIC_.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=replace-with-local-secret-or-service-role-key

# Optional canonical URL used when copying a share link.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
